---
/**
 * SourcesList — renders the Sources section that ends every article body.
 * Pulled from frontmatter `statutes_cited` array (and optionally extra
 * outbound URLs from a `sources` array).
 */
export interface Source {
  citation: string;
  url?: string;
  lastVerified?: string;
}

export interface Props {
  sources: Source[];
  title?: string;
}

const { sources, title = 'Sources' } = Astro.props;
---

<section class="sources-list" id="sources">
  <h2 class="sources-list__title">{title}</h2>
  <ol class="sources-list__list">
    {sources.map((src) => (
      <li class="sources-list__item">
        <div class="sources-list__citation">
          {src.url ? (
            <a href={src.url} target="_blank" rel="noopener noreferrer" class="underline-on-hover">
              {src.citation}
              <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 2 H10 V8 M10 2 L4 8" stroke-linecap="round"/>
              </svg>
            </a>
          ) : (
            <span>{src.citation}</span>
          )}
        </div>
        {src.lastVerified && (
          <span class="sources-list__verified">
            verified {new Date(src.lastVerified).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .sources-list {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-rule);
  }

  .sources-list__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 500, 'opsz' 36, 'wonk' 0;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-6);
  }

  .sources-list__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    counter-reset: src;
  }

  .sources-list__item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    align-items: baseline;
    counter-increment: src;
  }
  .sources-list__item:last-child { border-bottom: 0; }
  .sources-list__item::before {
    content: '[' counter(src, decimal-leading-zero) ']';
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-warm);
    grid-row: 1;
    grid-column: 1;
    align-self: start;
    padding-top: 0.2em;
    margin-right: var(--space-3);
  }

  .sources-list__citation {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink);
    grid-column: 1;
    margin-left: 3rem;
    margin-top: -1.4em;
  }
  .sources-list__citation a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
  }

  .sources-list__verified {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    white-space: nowrap;
  }
</style>
