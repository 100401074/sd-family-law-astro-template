---
/**
 * Hero — landing-page hero. Photo-led with typography overlay + dual CTA.
 *
 * Visual choice: NO stock-photo couples. The default uses a CSS-rendered
 * coastal-gradient abstract treatment as a placeholder; the dev swaps in a
 * real San Diego coastal/architecture photo. Typography is the dominant
 * element — kicker line, oversized H1 in Fraunces-via-Bricolage with WONK
 * for a touch of character, supporting sentence, then two CTAs.
 */
import { firm, telHref } from '../lib/firmConfig';

export interface Props {
  kicker?: string;
  headline?: string;
  sub?: string;
  primaryCta?: { label: string; href: string };
  /** Background image URL. If omitted, uses the abstract coastal treatment. */
  backgroundImage?: string;
}

const {
  kicker = 'San Diego Family Law — A Reader\'s Guide',
  headline = 'Family law guidance for the moments that matter most.',
  sub = 'Counsel without judgment. Clear answers about divorce, custody, support, and what comes next — written by a senior California attorney, not a content mill.',
  primaryCta = { label: 'Free consultation', href: '#consultation' },
  backgroundImage,
} = Astro.props;
---

<section class="hero" style={backgroundImage ? `--hero-image: url(${backgroundImage});` : undefined}>
  <div class="hero__atmosphere" aria-hidden="true">
    <div class="hero__sky"></div>
    <div class="hero__horizon"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__meta rise rise-1">
        <span class="hero__dot" aria-hidden="true"></span>
        <span class="hero__kicker">{kicker}</span>
      </div>

      <h1 class="hero__headline rise rise-2">
        {headline}
      </h1>

      <p class="hero__sub rise rise-3">{sub}</p>

      <div class="hero__actions rise rise-4">
        <a href={primaryCta.href} class="btn btn--primary btn--lg">{primaryCta.label}</a>
        <a href={telHref()} class="hero__phone underline-on-hover">
          <span class="hero__phone-label">or call directly</span>
          <span class="hero__phone-number">{firm.phoneDisplay}</span>
        </a>
      </div>

      <div class="hero__footnote rise rise-5">
        <span class="hero__footnote-mark" aria-hidden="true">●</span>
        <span>Same-day callbacks. Confidential. No pressure to retain.</span>
      </div>
    </div>

    <div class="hero__visual rise rise-3" aria-hidden="true">
      <div class="hero__plate">
        <div class="hero__plate-row">
          <span class="hero__plate-label">Reviewed by</span>
          <span class="hero__plate-value">CA-licensed family law attorney</span>
        </div>
        <div class="hero__plate-row">
          <span class="hero__plate-label">Jurisdiction</span>
          <span class="hero__plate-value">California Family Code</span>
        </div>
        <div class="hero__plate-row">
          <span class="hero__plate-label">Serves</span>
          <span class="hero__plate-value">San Diego County</span>
        </div>
        <div class="hero__plate-row hero__plate-row--accent">
          <span class="hero__plate-label">Available</span>
          <span class="hero__plate-value">{firm.hours}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__rule" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-20) var(--space-24);
    overflow: hidden;
    isolation: isolate;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-32) var(--space-32);
    }
  }

  /* Atmosphere — abstract coastal gradient when no image is supplied */
  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 80% 0%, rgba(197, 107, 75, 0.10), transparent 60%),
      radial-gradient(ellipse 60% 50% at 15% 10%, rgba(31, 58, 77, 0.06), transparent 60%),
      linear-gradient(180deg, var(--color-ground) 0%, color-mix(in srgb, var(--color-tint-warm) 60%, var(--color-ground)) 100%);
  }

  .hero__horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(180deg, transparent 0%, rgba(31, 58, 77, 0.04) 100%);
    border-bottom: 1px solid rgba(31, 58, 77, 0.08);
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    pointer-events: none;
    background-image:
      repeating-radial-gradient(circle at 0 0, transparent 0, rgba(15, 26, 46, 0.012) 1px, transparent 2px);
    background-size: 3px 3px;
    mix-blend-mode: multiply;
  }

  /* When a background image is provided */
  :global([style*="--hero-image"]) .hero__sky {
    background: var(--hero-image) center/cover no-repeat;
  }
  :global([style*="--hero-image"]) .hero__atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15,26,46,0.45) 0%, rgba(15,26,46,0.7) 100%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: end;
  }
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1.45fr 1fr;
      gap: var(--space-16);
    }
  }

  .hero__content {
    max-width: 38rem;
  }

  .hero__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-3);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    margin-bottom: var(--space-8);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-warm);
    box-shadow: 0 0 0 4px rgba(197, 107, 75, 0.15);
    animation: dot-pulse 2.4s ease-in-out infinite;
  }
  @keyframes dot-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(197, 107, 75, 0.15); }
    50%      { box-shadow: 0 0 0 8px rgba(197, 107, 75, 0.05); }
  }
  .hero__kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-variation-settings: 'wght' 500, 'opsz' 96, 'wonk' 1;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-8);
    text-wrap: balance;
    max-width: 16ch;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin-bottom: var(--space-10);
    max-width: 36ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .hero__phone {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-ink);
    background: none !important;
  }
  .hero__phone-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    text-transform: uppercase;
  }
  .hero__phone-number {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-variation-settings: 'wght' 500;
    letter-spacing: var(--tracking-snug);
    color: var(--color-accent);
  }

  .hero__footnote {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }
  .hero__footnote-mark { color: var(--color-success); font-size: 0.5em; }

  /* Right column — credentialed editorial "plate" — a quiet credibility object */
  .hero__visual {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero__visual {
      display: block;
    }
  }

  .hero__plate {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-7);
    box-shadow: 0 1px 0 var(--color-rule), 0 24px 48px -16px var(--color-shadow);
    position: relative;
  }
  .hero__plate::before {
    content: 'CONTENT ENGINE • SAMPLE 01';
    position: absolute;
    top: -10px;
    left: var(--space-5);
    background: var(--color-paper);
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    color: var(--color-ink-muted);
  }

  .hero__plate-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero__plate-row:last-child { border-bottom: none; padding-bottom: 0; }
  .hero__plate-row:first-child { padding-top: 0; }

  .hero__plate-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .hero__plate-value {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    text-align: right;
  }
  .hero__plate-row--accent .hero__plate-value {
    color: var(--color-accent-warm);
    font-weight: 600;
  }

  .hero__rule {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-rule) 20%,
      var(--color-rule-strong) 50%,
      var(--color-rule) 80%,
      transparent 100%);
  }
</style>
