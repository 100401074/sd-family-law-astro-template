---
/**
 * Header — primary site header with logo, nav, and click-to-call CTA.
 * Sticky on scroll with a subtle blur+border transition.
 */
import { firm, navigation, telHref } from '../lib/firmConfig';
---

<header class="header" data-header>
  <div class="header__inner container">
    <a href="/" class="header__logo" aria-label={`${firm.name} home`}>
      <span class="header__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
          <path d="M16 3 L29 10 L29 22 L16 29 L3 22 L3 10 Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M16 11 V21 M11 16 H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="header__name">
        <span class="header__name-1">San Diego</span>
        <span class="header__name-2">Family Law Advocates</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__nav-list">
        {navigation.primary.map((item) => (
          <li><a href={item.href} class="header__nav-link underline-on-hover">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={telHref()} class="header__phone" aria-label={`Call ${firm.phoneDisplay}`}>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
        </svg>
        <span>{firm.phoneDisplay}</span>
      </a>
      <a href="#consultation" class="btn btn--primary header__cta">Free consultation</a>
    </div>

    <button class="header__menu-toggle" aria-label="Open menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-ground) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) var(--easing-soft);
  }

  .header[data-scrolled] {
    border-bottom-color: var(--color-rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-4);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .header__logo:hover { color: var(--color-accent); }

  .header__mark {
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }

  .header__name {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    font-family: var(--font-display);
  }
  .header__name-1 {
    font-size: var(--text-sm);
    font-variation-settings: 'wght' 500;
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink-soft);
  }
  .header__name-2 {
    font-size: var(--text-md);
    font-variation-settings: 'wght' 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .header__nav { display: none; flex: 1; }
  @media (min-width: 1024px) { .header__nav { display: block; } }

  .header__nav-list {
    display: flex;
    gap: var(--space-7);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .header__nav-link {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
  }
  .header__nav-link:hover { color: var(--color-ink); }

  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
  }
  @media (min-width: 768px) { .header__actions { display: flex; } }

  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: var(--tracking-snug);
  }
  .header__phone svg { color: var(--color-accent-warm); }
  .header__phone:hover { color: var(--color-accent-warm); }

  .header__cta {
    /* defined in btn styles below */
  }

  .header__menu-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-left: auto;
    padding: var(--space-2);
  }
  .header__menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
  }
  @media (min-width: 1024px) { .header__menu-toggle { display: none; } }

  /* Button base (used by header CTA + elsewhere) */
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0.65em 1.4em;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--duration-quick) var(--easing-soft),
                color var(--duration-quick) var(--easing-soft),
                border-color var(--duration-quick) var(--easing-soft),
                transform var(--duration-quick) var(--easing-soft);
    white-space: nowrap;
  }

  :global(.btn--primary) {
    background: var(--color-accent);
    color: white;
    border: 1px solid var(--color-accent);
  }
  :global(.btn--primary:hover) {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  :global(.btn--secondary) {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-rule-strong);
  }
  :global(.btn--secondary:hover) {
    background: var(--color-tint-cool);
    border-color: var(--color-accent);
  }

  :global(.btn--warm) {
    background: var(--color-accent-warm);
    color: white;
    border: 1px solid var(--color-accent-warm);
  }
  :global(.btn--warm:hover) {
    background: var(--color-accent-warm-hover);
    border-color: var(--color-accent-warm-hover);
  }

  :global(.btn--lg) {
    padding: 0.85em 1.8em;
    font-size: var(--text-base);
  }
</style>

<script>
  // Add scroll-shadow on header
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
