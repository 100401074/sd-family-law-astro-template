---
/**
 * FootBlock — legal foot block that appears below the article body and above
 * the marketing CTA. Renders the three required compliance statements:
 *   1. Attorney Advertising disclosure
 *   2. About this article (reviewer + last updated)
 *   3. Disclaimer (no legal advice, no attorney-client relationship)
 *
 * The engine emits these as the final lines of every article; this component
 * renders them in a visually distinct foot-block style.
 */
import { firm, attorney } from '../lib/firmConfig';

export interface Props {
  reviewedBy?: string;
  lastUpdated?: string;
  /** Set to false on city/landing pages where the body already includes the foot block. */
  showAttorneyAdvertising?: boolean;
}

const {
  reviewedBy = `${attorney.name}, ${attorney.barState} Bar No. ${attorney.barNumber}`,
  lastUpdated,
  showAttorneyAdvertising = true,
} = Astro.props;

const dateFormatted = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<aside class="foot-block">
  <div class="foot-block__inner">
    {showAttorneyAdvertising && (
      <div class="foot-block__item">
        <p class="foot-block__label">Attorney Advertising</p>
        <p class="foot-block__body">
          This article is published by {firm.name} and constitutes attorney advertising under
          California Business and Professions Code § 6157 and California Rules of Professional
          Conduct 7.1–7.5.
        </p>
      </div>
    )}

    <div class="foot-block__item">
      <p class="foot-block__label">About this article</p>
      <p class="foot-block__body">
        Reviewed by {reviewedBy}.{dateFormatted && <> Last updated {dateFormatted}.</>}
      </p>
    </div>

    <div class="foot-block__item">
      <p class="foot-block__label">Disclaimer</p>
      <p class="foot-block__body">
        This article is for general informational purposes only and is not legal advice. Reading
        this article, contacting {firm.name}, or sending a message through this website does not
        create an attorney-client relationship. Prior results do not guarantee a similar outcome.
        Specific legal questions about your situation should be directed to a licensed
        {attorney.barState} family law attorney.
      </p>
    </div>
  </div>
</aside>

<style>
  .foot-block {
    margin-top: var(--space-16);
    padding-block: var(--space-10);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-tint-warm);
  }

  .foot-block__inner {
    max-width: var(--container-text);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .foot-block__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .foot-block__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin: 0;
  }

  .foot-block__body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin: 0;
  }
</style>
