---
/**
 * SanDiegoMap — a hand-drawn-style SVG of the San Diego region used as a
 * decorative geo anchor on City Page layouts. Not a real interactive map;
 * just a confident illustration that says "we know this place."
 *
 * Five courthouses marked: Downtown (Hall of Justice), East County (El Cajon),
 * North County (Vista), South Bay (Chula Vista), Family Court Annex.
 */
---

<figure class="sd-map">
  <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="San Diego County region illustration">
    <defs>
      <pattern id="dots" width="6" height="6" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.5" fill="var(--color-rule-strong)" opacity="0.4"/>
      </pattern>
      <filter id="paper-rough">
        <feTurbulence baseFrequency="0.9" numOctaves="2" result="noise"/>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="0.6"/>
      </filter>
    </defs>

    <!-- Ocean (Pacific) -->
    <rect x="0" y="0" width="120" height="320" fill="url(#dots)" opacity="0.6"/>
    <text x="30" y="160" font-family="var(--font-display)" font-size="11" font-style="italic" fill="var(--color-ink-muted)" transform="rotate(-90, 30, 160)">Pacific Ocean</text>

    <!-- Coastline / region outline (deliberately rough, not geographically precise) -->
    <path
      d="M 120 30
         C 130 45, 140 35, 155 50
         L 175 55
         C 200 50, 220 65, 250 60
         L 290 70
         C 320 75, 350 70, 380 85
         L 385 130
         C 380 160, 370 180, 365 210
         L 360 240
         C 340 270, 310 280, 280 285
         L 250 290
         C 220 295, 190 285, 165 280
         L 140 270
         C 130 250, 120 220, 125 190
         L 122 160
         C 118 130, 115 100, 120 70 Z"
      fill="var(--color-tint-warm)"
      stroke="var(--color-accent)"
      stroke-width="1.5"
      stroke-linejoin="round"
      stroke-linecap="round"
    />

    <!-- Border with Mexico -->
    <line x1="140" y1="290" x2="260" y2="290" stroke="var(--color-accent-warm)" stroke-width="1.5" stroke-dasharray="2,4"/>
    <text x="195" y="306" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)" text-anchor="middle">— Mexico —</text>

    <!-- Region labels (subtle) -->
    <text x="280" y="100" font-family="var(--font-display)" font-size="10" font-style="italic" fill="var(--color-ink-muted)">North County</text>
    <text x="290" y="180" font-family="var(--font-display)" font-size="10" font-style="italic" fill="var(--color-ink-muted)">East County</text>
    <text x="180" y="260" font-family="var(--font-display)" font-size="10" font-style="italic" fill="var(--color-ink-muted)">South Bay</text>

    <!-- Courthouse markers (terracotta dots with labels) -->
    <g>
      <!-- Vista (North County) -->
      <circle cx="270" cy="115" r="5" fill="var(--color-accent-warm)" stroke="var(--color-paper)" stroke-width="1.5"/>
      <text x="278" y="118" font-family="var(--font-body)" font-size="9" font-weight="600" fill="var(--color-ink)">Vista</text>

      <!-- El Cajon (East County) -->
      <circle cx="280" cy="195" r="5" fill="var(--color-accent-warm)" stroke="var(--color-paper)" stroke-width="1.5"/>
      <text x="288" y="198" font-family="var(--font-body)" font-size="9" font-weight="600" fill="var(--color-ink)">El Cajon</text>

      <!-- Chula Vista (South Bay) -->
      <circle cx="195" cy="265" r="5" fill="var(--color-accent-warm)" stroke="var(--color-paper)" stroke-width="1.5"/>
      <text x="203" y="268" font-family="var(--font-body)" font-size="9" font-weight="600" fill="var(--color-ink)">Chula Vista</text>

      <!-- Downtown San Diego (Hall of Justice) — larger marker -->
      <circle cx="180" cy="200" r="8" fill="var(--color-accent)" stroke="var(--color-paper)" stroke-width="2"/>
      <text x="192" y="204" font-family="var(--font-display)" font-size="11" font-style="italic" font-weight="500" fill="var(--color-accent)">Downtown SD</text>
      <text x="192" y="215" font-family="var(--font-mono)" font-size="7" fill="var(--color-ink-muted)">Hall of Justice</text>
    </g>

    <!-- Compass — small editorial detail -->
    <g transform="translate(355, 30)">
      <circle cx="0" cy="0" r="14" fill="none" stroke="var(--color-rule-strong)" stroke-width="1"/>
      <path d="M 0 -10 L 3 0 L 0 10 L -3 0 Z" fill="var(--color-accent-warm)" opacity="0.8"/>
      <text x="0" y="-15" font-family="var(--font-mono)" font-size="7" fill="var(--color-ink-muted)" text-anchor="middle">N</text>
    </g>
  </svg>

  <figcaption class="sd-map__caption">
    San Diego County family law venues. Cases are typically heard at the courthouse closest to where the petitioner resides.
  </figcaption>
</figure>

<style>
  .sd-map {
    margin: 0;
    padding: var(--space-6);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 0 var(--color-rule), 0 8px 24px -12px var(--color-shadow);
  }

  .sd-map svg {
    width: 100%;
    height: auto;
    max-width: 480px;
    margin-inline: auto;
    display: block;
  }

  .sd-map__caption {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
    text-align: center;
    margin-top: var(--space-5);
    font-style: italic;
    max-width: 38ch;
    margin-inline: auto;
  }
</style>
