---
/**
 * Credentials — a quiet horizontal strip of recognized credentials, between
 * primary content sections. Uses text-only credential labels by default since
 * real logo files are firm-specific; the dev swaps the .svg placeholders in
 * /public/credentials/ to drop in real Avvo / State Bar / Super Lawyers logos.
 */
import { credentials } from '../lib/firmConfig';
---

<section class="credentials">
  <div class="container">
    <div class="credentials__inner">
      <p class="credentials__label">Recognized by</p>
      <ul class="credentials__list">
        {credentials.map((cred) => (
          <li class="credentials__item">{cred.label}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .credentials {
    padding-block: var(--space-10);
    background: var(--color-tint-warm);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .credentials__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .credentials__inner {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-10);
    }
  }

  .credentials__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
    white-space: nowrap;
  }

  .credentials__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    list-style: none;
    padding: 0;
    margin: 0;
    justify-content: center;
  }

  .credentials__item {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-variation-settings: 'wght' 400, 'opsz' 24, 'wonk' 0;
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink-soft);
    position: relative;
  }
</style>
