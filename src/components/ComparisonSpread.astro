---
/**
 * ComparisonSpread — split-spread layout for Option A vs Option B comparison
 * articles. Two adjacent cards with a vertical "vs" divider in the middle on
 * desktop. Each card has a kicker, name, statute basis, summary, and key facts.
 *
 * Use for: "Legal Separation vs. Divorce", "Mediation vs. Litigation",
 * "Joint vs. Sole Custody", etc.
 */
export interface ComparisonOption {
  kicker?: string;
  name: string;
  statuteBasis?: string;  /* e.g., "Cal. Fam. Code § 2310" */
  summary: string;
  whenItFits?: string[];
}

export interface Props {
  optionA: ComparisonOption;
  optionB: ComparisonOption;
}

const { optionA, optionB } = Astro.props;
---

<section class="comparison-spread">
  <div class="comparison-spread__inner">
    <article class="comparison-card">
      {optionA.kicker && <p class="comparison-card__kicker">{optionA.kicker}</p>}
      <h3 class="comparison-card__name">{optionA.name}</h3>
      {optionA.statuteBasis && (
        <p class="comparison-card__basis">{optionA.statuteBasis}</p>
      )}
      <p class="comparison-card__summary">{optionA.summary}</p>
      {optionA.whenItFits && optionA.whenItFits.length > 0 && (
        <div class="comparison-card__fits">
          <p class="comparison-card__fits-label">Typically fits when</p>
          <ul class="comparison-card__list">
            {optionA.whenItFits.map((fit) => <li>{fit}</li>)}
          </ul>
        </div>
      )}
    </article>

    <div class="comparison-spread__divider" aria-hidden="true">
      <span class="comparison-spread__vs">vs</span>
    </div>

    <article class="comparison-card comparison-card--alt">
      {optionB.kicker && <p class="comparison-card__kicker">{optionB.kicker}</p>}
      <h3 class="comparison-card__name">{optionB.name}</h3>
      {optionB.statuteBasis && (
        <p class="comparison-card__basis">{optionB.statuteBasis}</p>
      )}
      <p class="comparison-card__summary">{optionB.summary}</p>
      {optionB.whenItFits && optionB.whenItFits.length > 0 && (
        <div class="comparison-card__fits">
          <p class="comparison-card__fits-label">Typically fits when</p>
          <ul class="comparison-card__list">
            {optionB.whenItFits.map((fit) => <li>{fit}</li>)}
          </ul>
        </div>
      )}
    </article>
  </div>
</section>

<style>
  .comparison-spread {
    background: var(--color-tint-warm);
    border-block: 1px solid var(--color-rule);
    padding-block: var(--space-16);
    margin-block: var(--space-12);
  }

  .comparison-spread__inner {
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .comparison-spread__inner {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--space-10);
    }
  }

  .comparison-card {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-8) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
  }

  .comparison-card--alt {
    background: var(--color-paper);
    border-color: var(--color-rule);
  }
  .comparison-card--alt::before {
    background: var(--color-accent);
  }
  .comparison-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent-warm);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .comparison-card__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .comparison-card__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-variation-settings: 'wght' 500, 'opsz' 48, 'wonk' 0;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .comparison-card__basis {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin: 0;
  }

  .comparison-card__summary {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    margin: 0;
  }

  .comparison-card__fits {
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  .comparison-card__fits-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin: 0 0 var(--space-3);
  }
  .comparison-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }
  .comparison-card__list li {
    position: relative;
    padding-left: var(--space-5);
  }
  .comparison-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-warm);
  }

  .comparison-spread__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) 0;
  }
  @media (min-width: 768px) {
    .comparison-spread__divider {
      flex-direction: column;
      padding: 0;
      position: relative;
    }
    .comparison-spread__divider::before,
    .comparison-spread__divider::after {
      content: '';
      flex: 1;
      width: 1px;
      background: var(--color-rule);
    }
  }

  .comparison-spread__vs {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 400, 'opsz' 36, 'wonk' 1;
    font-style: italic;
    color: var(--color-accent-warm);
    padding: var(--space-3) var(--space-4);
    background: var(--color-tint-warm);
    border-radius: 999px;
    border: 1px solid var(--color-rule);
  }
</style>
