---
/**
 * /admin — in-browser preview admin for firm.config.json values.
 *
 * Architectural note: this is a STATIC preview tool. It does not write to
 * the server. The form lets you edit firm values, see them reflected live
 * on the page, and download the updated JSON to drop back into the repo.
 *
 * For real persisted admin editing, drop in Decap CMS or Sveltia CMS — both
 * commit changes to GitHub via OAuth and trigger a redeploy. See README.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { firmConfig } from '../../lib/firmConfig';
---

<BaseLayout
  title="Admin Preview — Firm Config Editor"
  description="In-browser editor for firm.config.json values. Static template tool; for persisted CMS use Decap or Sveltia."
>
  <section class="admin">
    <div class="container">
      <header class="admin__header">
        <p class="kicker">Template tool</p>
        <h1 class="admin__title">Firm Config Editor</h1>
        <p class="admin__intro">
          Edit any of the firm-level values below. Changes are reflected live
          in the form preview but do not write to the server. When you're done,
          click <strong>Download updated JSON</strong> and replace the contents
          of <code>firm.config.json</code> at the repo root. Committing the file
          and pushing will redeploy the site with your changes.
        </p>
        <p class="admin__note">
          <strong>Looking for a persisted CMS?</strong> See <em>README → Adding a real admin</em> for the
          drop-in Decap / Sveltia setup that commits changes via GitHub OAuth.
        </p>
      </header>

      <form class="admin__form" data-firm-form>
        <fieldset class="admin__group">
          <legend>Firm</legend>
          <div class="admin__field">
            <label for="firm-name">Firm name</label>
            <input id="firm-name" name="firm.name" type="text" value={firmConfig.firm.name} />
          </div>
          <div class="admin__field">
            <label for="firm-shortName">Short name (used in page titles)</label>
            <input id="firm-shortName" name="firm.shortName" type="text" value={firmConfig.firm.shortName} />
          </div>
          <div class="admin__field admin__field--wide">
            <label for="firm-tagline">Tagline (used in hero + meta description)</label>
            <textarea id="firm-tagline" name="firm.tagline" rows="2">{firmConfig.firm.tagline}</textarea>
          </div>
          <div class="admin__row">
            <div class="admin__field">
              <label for="firm-phone">Phone (machine)</label>
              <input id="firm-phone" name="firm.phone" type="text" value={firmConfig.firm.phone} />
            </div>
            <div class="admin__field">
              <label for="firm-phoneDisplay">Phone (display)</label>
              <input id="firm-phoneDisplay" name="firm.phoneDisplay" type="text" value={firmConfig.firm.phoneDisplay} />
            </div>
          </div>
          <div class="admin__row">
            <div class="admin__field">
              <label for="firm-hours">Hours (CTA line)</label>
              <input id="firm-hours" name="firm.hours" type="text" value={firmConfig.firm.hours} />
            </div>
            <div class="admin__field">
              <label for="firm-consultationOffer">Consultation offer</label>
              <input id="firm-consultationOffer" name="firm.consultationOffer" type="text" value={firmConfig.firm.consultationOffer} />
            </div>
          </div>
          <div class="admin__field admin__field--wide">
            <label for="firm-intakeUrl">Intake form URL</label>
            <input id="firm-intakeUrl" name="firm.intakeUrl" type="url" value={firmConfig.firm.intakeUrl} />
          </div>
        </fieldset>

        <fieldset class="admin__group">
          <legend>Reviewing attorney (byline)</legend>
          <div class="admin__row">
            <div class="admin__field">
              <label for="attorney-name">Full name</label>
              <input id="attorney-name" name="attorney.name" type="text" value={firmConfig.attorney.name} />
            </div>
            <div class="admin__field">
              <label for="attorney-title">Title</label>
              <input id="attorney-title" name="attorney.title" type="text" value={firmConfig.attorney.title} />
            </div>
          </div>
          <div class="admin__row">
            <div class="admin__field">
              <label for="attorney-barState">Bar state</label>
              <input id="attorney-barState" name="attorney.barState" type="text" value={firmConfig.attorney.barState} maxlength="2" />
            </div>
            <div class="admin__field">
              <label for="attorney-barNumber">Bar number</label>
              <input id="attorney-barNumber" name="attorney.barNumber" type="text" value={firmConfig.attorney.barNumber} />
            </div>
            <div class="admin__field">
              <label for="attorney-admissionYear">Admitted</label>
              <input id="attorney-admissionYear" name="attorney.admissionYear" type="text" value={firmConfig.attorney.admissionYear} />
            </div>
          </div>
          <div class="admin__field admin__field--wide">
            <label for="attorney-stateBarProfileUrl">State Bar profile URL</label>
            <input id="attorney-stateBarProfileUrl" name="attorney.stateBarProfileUrl" type="url" value={firmConfig.attorney.stateBarProfileUrl} />
          </div>
        </fieldset>

        <fieldset class="admin__group">
          <legend>Address</legend>
          <div class="admin__field admin__field--wide">
            <label for="firm-address-street">Street</label>
            <input id="firm-address-street" name="firm.address.street" type="text" value={firmConfig.firm.address.street} />
          </div>
          <div class="admin__row">
            <div class="admin__field">
              <label for="firm-address-city">City</label>
              <input id="firm-address-city" name="firm.address.city" type="text" value={firmConfig.firm.address.city} />
            </div>
            <div class="admin__field">
              <label for="firm-address-state">State</label>
              <input id="firm-address-state" name="firm.address.state" type="text" value={firmConfig.firm.address.state} />
            </div>
            <div class="admin__field">
              <label for="firm-address-postalCode">Postal</label>
              <input id="firm-address-postalCode" name="firm.address.postalCode" type="text" value={firmConfig.firm.address.postalCode} />
            </div>
          </div>
        </fieldset>

        <div class="admin__actions">
          <button type="button" class="btn btn--primary btn--lg" data-action="download">Download updated JSON</button>
          <button type="button" class="btn btn--secondary btn--lg" data-action="copy">Copy to clipboard</button>
          <button type="button" class="btn btn--secondary btn--lg" data-action="reset">Reset to current</button>
        </div>

        <div class="admin__preview" data-preview>
          <h3 class="admin__preview-title">Preview of generated JSON</h3>
          <pre class="admin__preview-code" data-preview-output></pre>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .admin {
    padding-block: var(--space-16);
  }
  .admin__header {
    max-width: var(--container-narrow);
    margin-bottom: var(--space-12);
  }
  .admin__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-variation-settings: 'wght' 500, 'opsz' 80, 'wonk' 1;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-block: var(--space-3) var(--space-5);
  }
  .admin__intro, .admin__note {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .admin__note {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-tint-warm);
    border-left: 3px solid var(--color-accent-warm);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--text-sm);
  }
  .admin__intro :global(code), .admin__note :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-paper);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    border: 1px solid var(--color-rule);
  }

  .admin__form {
    max-width: var(--container-narrow);
  }

  .admin__group {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-7);
    margin-bottom: var(--space-6);
    background: var(--color-paper);
  }
  .admin__group legend {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    padding-inline: var(--space-3);
  }

  .admin__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .admin__row { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  }

  .admin__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .admin__field label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-soft);
  }
  .admin__field input,
  .admin__field textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-ink);
    background: var(--color-ground);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--duration-quick) var(--easing-soft), box-shadow var(--duration-quick) var(--easing-soft);
  }
  .admin__field input:focus,
  .admin__field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }
  .admin__field--wide { grid-column: 1 / -1; }

  .admin__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-8) var(--space-6);
  }

  .admin__preview {
    background: var(--color-ink);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    color: var(--color-tint-warm);
  }
  .admin__preview-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin: 0 0 var(--space-3);
  }
  .admin__preview-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    overflow-x: auto;
    margin: 0;
    max-height: 400px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>

<script define:vars={{ initialConfig: firmConfig }}>
  const form = document.querySelector('[data-firm-form]');
  const previewOutput = document.querySelector('[data-preview-output]');

  /** Set a value at a dotted path inside an object. */
  function setPath(obj, path, value) {
    const parts = path.split('.');
    let cursor = obj;
    for (let i = 0; i < parts.length - 1; i++) {
      const key = parts[i];
      if (!(key in cursor) || typeof cursor[key] !== 'object' || cursor[key] === null) {
        cursor[key] = {};
      }
      cursor = cursor[key];
    }
    cursor[parts[parts.length - 1]] = value;
  }

  /** Get the current edited config from the form. */
  function harvest() {
    const out = JSON.parse(JSON.stringify(initialConfig));
    const inputs = form.querySelectorAll('input[name], textarea[name]');
    inputs.forEach((el) => {
      setPath(out, el.name, el.value);
    });
    return out;
  }

  /** Pretty-print + update the preview panel. */
  function refresh() {
    const cfg = harvest();
    previewOutput.textContent = JSON.stringify(cfg, null, 2);
  }

  form.addEventListener('input', refresh);
  refresh();

  form.querySelector('[data-action="download"]').addEventListener('click', () => {
    const cfg = harvest();
    const blob = new Blob([JSON.stringify(cfg, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'firm.config.json';
    a.click();
    URL.revokeObjectURL(url);
  });

  form.querySelector('[data-action="copy"]').addEventListener('click', async () => {
    const cfg = harvest();
    try {
      await navigator.clipboard.writeText(JSON.stringify(cfg, null, 2));
      const btn = form.querySelector('[data-action="copy"]');
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = original; }, 1500);
    } catch (err) {
      console.error('clipboard write failed', err);
    }
  });

  form.querySelector('[data-action="reset"]').addEventListener('click', () => {
    form.reset();
    refresh();
  });
</script>
