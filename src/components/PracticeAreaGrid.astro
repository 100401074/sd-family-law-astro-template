---
/**
 * PracticeAreaGrid — card grid of the firm's practice areas. Pulls from
 * firm.config.json so the dev controls what's shown by editing the JSON.
 *
 * Visual logic: cards are paper-on-warm-ground with restrained type, a small
 * monogram per area, and a "Read the guide" link that animates on hover. The
 * grid uses a layout that intentionally varies card heights through copy
 * length, avoiding the flat-uniform-tile look of generic legal sites.
 */
import { practiceAreas } from '../lib/firmConfig';
---

<section class="practice-areas section">
  <div class="container">
    <header class="practice-areas__header">
      <p class="kicker">Practice Areas</p>
      <h2 class="practice-areas__title">
        Family law, narrowly and<br />
        <span class="practice-areas__title-em">deliberately practiced.</span>
      </h2>
      <p class="practice-areas__intro">
        California Family Code is a body of law that rewards focused practice.
        Each area below is a guide written by an attorney who handles these cases,
        not a marketing summary.
      </p>
    </header>

    <div class="practice-areas__grid">
      {practiceAreas.map((area, idx) => (
        <a href={`/practice-areas/${area.slug}`} class="area-card">
          <div class="area-card__index">{String(idx + 1).padStart(2, '0')}</div>
          <h3 class="area-card__title">{area.title}</h3>
          <p class="area-card__summary">{area.summary}</p>
          <span class="area-card__link">
            Read the guide
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M3 8 H13 M9 4 L13 8 L9 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .practice-areas {
    background:
      linear-gradient(180deg, var(--color-ground) 0%, color-mix(in srgb, var(--color-tint-warm) 50%, var(--color-ground)) 100%);
  }

  .practice-areas__header {
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-16);
    text-align: center;
  }

  .practice-areas__header .kicker {
    margin-bottom: var(--space-3);
  }

  .practice-areas__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-variation-settings: 'wght' 500, 'opsz' 80, 'wonk' 1;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-6);
    text-wrap: balance;
  }
  .practice-areas__title-em {
    font-style: italic;
    color: var(--color-accent);
    font-variation-settings: 'wght' 400, 'opsz' 80, 'wonk' 1;
  }

  .practice-areas__intro {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    max-width: 44ch;
    margin: 0 auto;
    text-wrap: balance;
  }

  .practice-areas__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px)  { .practice-areas__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .practice-areas__grid { grid-template-columns: repeat(4, 1fr); } }

  .area-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition:
      transform var(--duration-base) var(--easing-soft),
      border-color var(--duration-base) var(--easing-soft),
      box-shadow var(--duration-base) var(--easing-soft);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .area-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    pointer-events: none;
    background: linear-gradient(140deg, transparent 0%, rgba(197, 107, 75, 0.04) 100%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--easing-soft);
  }

  .area-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 16px 32px -8px var(--color-shadow), 0 4px 8px -2px var(--color-shadow);
  }
  .area-card:hover::after { opacity: 1; }

  .area-card__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent-warm);
  }

  .area-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 500, 'opsz' 40, 'wonk' 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: var(--space-2) 0 0;
    text-wrap: balance;
  }

  .area-card__summary {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    flex: 1;
  }

  .area-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: var(--space-2);
    transition: color var(--duration-quick) var(--easing-soft);
  }
  .area-card__link svg {
    transition: transform var(--duration-base) var(--easing-soft);
  }
  .area-card:hover .area-card__link {
    color: var(--color-accent-warm);
  }
  .area-card:hover .area-card__link svg {
    transform: translateX(4px);
  }
</style>
