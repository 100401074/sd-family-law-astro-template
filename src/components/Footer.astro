---
/**
 * Footer — site-wide footer with practice areas + nav + firm meta + legal foot block.
 * The "Attorney Advertising / Disclaimer" rendering belongs INSIDE the article foot
 * block (per the engine's article frontmatter); this is the firm/site footer.
 */
import { firm, navigation, practiceAreas, telHref, listAreas } from '../lib/firmConfig';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <svg viewBox="0 0 32 32" width="40" height="40" fill="none" aria-hidden="true">
            <path d="M16 3 L29 10 L29 22 L16 29 L3 22 L3 10 Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M16 11 V21 M11 16 H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>{firm.name}</span>
        </a>
        <p class="footer__tagline">{firm.tagline}</p>
        <p class="footer__address">
          <strong>{firm.address.street}</strong><br />
          {firm.address.city}, {firm.address.state} {firm.address.postalCode}
        </p>
        <p class="footer__contact">
          <a href={telHref()} class="underline-on-hover">{firm.phoneDisplay}</a>
          <span class="footer__sep">•</span>
          <a href={firm.intakeUrl} class="underline-on-hover">Contact form</a>
        </p>
      </div>

      <div class="footer__col">
        <h3 class="footer__heading">Practice Areas</h3>
        <ul class="footer__list">
          {practiceAreas.slice(0, 6).map((area) => (
            <li><a href={`/practice-areas/${area.slug}`} class="underline-on-hover">{area.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3 class="footer__heading">Resources</h3>
        <ul class="footer__list">
          {navigation.primary.map((item) => (
            <li><a href={item.href} class="underline-on-hover">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3 class="footer__heading">Areas Served</h3>
        <p class="footer__served">{listAreas()}, and surrounding San Diego County communities.</p>
      </div>
    </div>

    <div class="footer__meta">
      <p class="footer__copy">© {year} {firm.name}. All rights reserved.</p>
      <p class="footer__legal">
        <a href="/disclaimer">Disclaimer</a>
        <span class="footer__sep">•</span>
        <a href="/privacy">Privacy</a>
        <span class="footer__sep">•</span>
        <a href="/accessibility">Accessibility</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-tint-warm);
    padding-block: var(--space-20) var(--space-10);
    margin-top: var(--space-32);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .footer a {
    color: var(--color-tint-warm);
  }
  .footer a:hover { color: var(--color-accent-warm); }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 640px)  { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer__grid { grid-template-columns: 2fr 1fr 1fr 1.2fr; } }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: white;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-variation-settings: 'wght' 500;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-5);
  }
  .footer__logo svg { color: var(--color-accent-warm); }

  .footer__tagline {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-6);
    max-width: 36ch;
    line-height: var(--leading-relaxed);
  }

  .footer__address {
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
  }
  .footer__address strong { color: rgba(255, 255, 255, 0.9); font-weight: 500; }

  .footer__contact {
    color: rgba(255, 255, 255, 0.85);
  }
  .footer__sep {
    display: inline-block;
    margin-inline: var(--space-2);
    color: rgba(255, 255, 255, 0.3);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin-bottom: var(--space-5);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__served {
    color: rgba(255, 255, 255, 0.7);
    max-width: 28ch;
    line-height: var(--leading-relaxed);
  }

  .footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-8);
    color: rgba(255, 255, 255, 0.5);
    font-size: var(--text-xs);
  }
  @media (min-width: 640px) {
    .footer__meta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .footer__copy { margin: 0; }
  .footer__legal { margin: 0; }
</style>
