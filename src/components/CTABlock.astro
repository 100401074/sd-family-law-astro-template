---
/**
 * CTABlock — Steve's approved call-to-action block, used below every article
 * body and as the closing section on landing/practice pages.
 *
 * Visual logic: distinctly NOT the article voice. Tinted ground, terracotta
 * top rule, large display headline, dual action (phone + form), Steve's exact
 * closing values phrase set in body type below the buttons. This is the firm
 * speaking directly.
 *
 * Architectural separation: per the 2026-05-27 decision, the marketing-tone
 * CTA lives OUTSIDE the article body. The article's own closing CTA stays in
 * the plain-English peer-attorney voice that the quality scorer rewards;
 * this block carries the directness Steve wants.
 */
import { firm, telHref } from '../lib/firmConfig';

export interface Props {
  /** Override the eyebrow text (default: empty). */
  eyebrow?: string;
  /** Override the main headline (default: Steve's pattern). */
  headline?: string;
  /** Override the supporting values phrase (default: Steve's exact phrase). */
  values?: string;
  /** Override the variant. Default 'tinted' (soft navy background); 'inverted' for dark. */
  variant?: 'tinted' | 'inverted' | 'minimal';
  /** Use an HTML id anchor for in-page navigation. */
  id?: string;
}

const {
  eyebrow,
  headline = `Contact us ${firm.hours} for a ${firm.consultationOffer}`,
  values = "We're here to provide the legal support you need, the compassion you deserve, and a path forward toward a brighter future.",
  variant = 'tinted',
  id = 'consultation',
} = Astro.props;
---

<section class:list={['cta-block', `cta-block--${variant}`]} id={id}>
  <div class="container">
    <div class="cta-block__inner">
      <hr class="cta-block__rule" aria-hidden="true" />

      {eyebrow && <p class="cta-block__eyebrow">{eyebrow}</p>}

      <h2 class="cta-block__headline">{headline}</h2>

      <div class="cta-block__actions">
        <a href={telHref()} class="btn btn--warm btn--lg cta-block__phone">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z"/>
          </svg>
          <span>Call {firm.phoneDisplay}</span>
        </a>
        <a href={firm.intakeUrl} class="btn btn--secondary btn--lg">
          Fill out the form
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M3 8 H13 M8 3 L13 8 L8 13" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <p class="cta-block__values">{values}</p>
    </div>
  </div>
</section>

<style>
  .cta-block {
    padding-block: var(--space-20);
    position: relative;
    overflow: hidden;
  }

  .cta-block--tinted {
    background: var(--color-tint-accent);
    color: var(--color-ink);
  }

  .cta-block--inverted {
    background: var(--color-ink);
    color: var(--color-tint-warm);
  }
  .cta-block--inverted .cta-block__headline { color: white; }
  .cta-block--inverted .cta-block__values { color: rgba(255,255,255,0.75); }

  .cta-block--minimal {
    background: transparent;
    padding-block: var(--space-16);
  }
  .cta-block--minimal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: var(--container-text);
    max-width: calc(100% - var(--space-12));
    border-top: 1px solid var(--color-rule);
  }

  .cta-block__inner {
    max-width: var(--container-narrow);
    margin-inline: auto;
    text-align: center;
  }

  .cta-block__rule {
    border: 0;
    border-top: 2px solid var(--color-accent-warm);
    width: 3rem;
    margin: 0 auto var(--space-8);
  }
  .cta-block--minimal .cta-block__rule { display: none; }

  .cta-block__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin-bottom: var(--space-4);
  }

  .cta-block__headline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-variation-settings: 'wght' 500, 'opsz' 56, 'wonk' 1;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    max-width: 22ch;
    margin: 0 auto var(--space-8);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .cta-block__headline {
      font-size: var(--text-4xl);
    }
  }

  .cta-block__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .cta-block__values {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    max-width: 44ch;
    margin: 0 auto;
    text-wrap: balance;
  }
</style>
