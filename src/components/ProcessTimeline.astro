---
/**
 * ProcessTimeline — vertical numbered timeline for Process Guide articles.
 * Each step renders as a card with a roman-numeral marker on the left rail
 * connected by a continuous vertical line. Steps can include time anchors,
 * form-number references, and cost notes.
 */
export interface ProcessStep {
  title: string;
  body: string;            /* HTML allowed */
  duration?: string;       /* "2-4 weeks" */
  form?: string;           /* "FL-100" */
  cost?: string;           /* "$435 (waivable)" */
}

export interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;

const romans = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
---

<ol class="process-timeline" role="list">
  {steps.map((step, idx) => (
    <li class="process-step">
      <div class="process-step__rail" aria-hidden="true">
        <div class="process-step__numeral">{romans[idx] ?? String(idx + 1)}</div>
        {idx < steps.length - 1 && <div class="process-step__line" />}
      </div>

      <div class="process-step__card">
        <p class="process-step__index">Step {idx + 1} of {steps.length}</p>
        <h3 class="process-step__title">{step.title}</h3>

        {(step.duration || step.form || step.cost) && (
          <div class="process-step__meta">
            {step.duration && (
              <span class="process-step__meta-pill">
                <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <circle cx="6" cy="6" r="4.5"/>
                  <path d="M6 3 V6 L8 7.5" stroke-linecap="round"/>
                </svg>
                {step.duration}
              </span>
            )}
            {step.form && (
              <span class="process-step__meta-pill">
                <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <path d="M3 1 H9 V11 H3 Z M5 4 H8 M5 6 H8 M5 8 H7" stroke-linecap="round"/>
                </svg>
                Form {step.form}
              </span>
            )}
            {step.cost && (
              <span class="process-step__meta-pill process-step__meta-pill--cost">
                {step.cost}
              </span>
            )}
          </div>
        )}

        <div class="process-step__body" set:html={step.body} />
      </div>
    </li>
  ))}
</ol>

<style>
  .process-timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .process-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 768px) {
    .process-step { grid-template-columns: 80px 1fr; gap: var(--space-8); }
  }

  .process-step__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
    position: relative;
  }

  .process-step__numeral {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 500, 'opsz' 32, 'wonk' 1;
    font-style: italic;
    color: var(--color-accent);
    background: var(--color-paper);
    border: 2px solid var(--color-accent-warm);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .process-step__line {
    flex: 1;
    width: 2px;
    background: var(--color-rule);
    margin-top: var(--space-2);
    min-height: var(--space-12);
  }

  .process-step__card {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-6) var(--space-7);
  }

  .process-step__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent-warm);
    margin: 0 0 var(--space-3);
  }

  .process-step__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 500, 'opsz' 36, 'wonk' 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }

  .process-step__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .process-step__meta-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--color-tint-cool);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }
  .process-step__meta-pill svg { color: var(--color-accent); }
  .process-step__meta-pill--cost {
    color: var(--color-accent-warm);
    border-color: var(--color-accent-warm-soft);
    background: color-mix(in srgb, var(--color-accent-warm) 8%, var(--color-paper));
  }

  .process-step__body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }
  .process-step__body :global(p) { margin-bottom: var(--space-3); }
  .process-step__body :global(p:last-child) { margin-bottom: 0; }
  .process-step__body :global(strong) { color: var(--color-ink); font-weight: 600; }
  .process-step__body :global(a) {
    color: var(--color-accent);
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 100% 1px;
  }
</style>
