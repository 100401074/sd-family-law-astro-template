---
/**
 * ArticleIndex — section that lists all engine-generated articles on the home
 * page. Pulls from the articles content collection, groups by page_type, and
 * renders each as an editorial card with the page-type kicker.
 */
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const ordered = articles.sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

const PAGE_KICKERS: Record<string, string> = {
  'cost-article': 'Cost Article',
  'explainer': 'Explainer',
  'faq': 'FAQ',
  'comparison': 'Comparison',
  'process-guide': 'Process Guide',
  'city-page': 'City Page',
  'landing': 'Landing',
  'pillar': 'Pillar Guide',
};
---

<section class="article-index section">
  <div class="container">
    <header class="article-index__header">
      <p class="kicker">From the content engine</p>
      <h2 class="article-index__title">
        Sample articles — <span class="article-index__em">one per page type.</span>
      </h2>
      <p class="article-index__intro">
        These are real outputs of the content engine, rendered through the
        template. Each card opens an article that uses the corresponding
        layout — accordion FAQs, comparison spreads, process timelines,
        city maps. Edit the markdown in <code>src/content/articles/</code>
        to add your own.
      </p>
    </header>

    <div class="article-index__grid">
      {ordered.map((article, idx) => (
        <a href={`/articles/${article.id}`} class="article-index-card">
          <div class="article-index-card__head">
            <span class="article-index-card__index">{String(idx + 1).padStart(2, '0')}</span>
            <span class="article-index-card__kicker">{PAGE_KICKERS[article.data.page_type] ?? article.data.page_type}</span>
          </div>
          <h3 class="article-index-card__title">{article.data.title}</h3>
          <p class="article-index-card__desc">{article.data.description}</p>
          <span class="article-index-card__cta">
            View article
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M3 8 H13 M9 4 L13 8 L9 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .article-index {
    background: var(--color-tint-warm);
  }

  .article-index__header {
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-12);
    text-align: center;
  }
  .article-index__header .kicker { margin-bottom: var(--space-3); }

  .article-index__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-variation-settings: 'wght' 500, 'opsz' 64, 'wonk' 1;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin-bottom: var(--space-5);
    text-wrap: balance;
  }
  .article-index__em {
    font-style: italic;
    color: var(--color-accent);
    font-variation-settings: 'wght' 400, 'opsz' 64, 'wonk' 1;
  }

  .article-index__intro {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    max-width: 48ch;
    margin: 0 auto;
    text-wrap: balance;
  }
  .article-index__intro :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-paper);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }

  .article-index__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 640px)  { .article-index__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .article-index__grid { grid-template-columns: 1fr 1fr 1fr; } }

  .article-index-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--easing-soft),
      border-color var(--duration-base) var(--easing-soft),
      box-shadow var(--duration-base) var(--easing-soft);
  }
  .article-index-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 18px 36px -12px var(--color-shadow);
  }

  .article-index-card__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .article-index-card__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-accent-warm);
  }
  .article-index-card__kicker {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .article-index-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-variation-settings: 'wght' 500, 'opsz' 32, 'wonk' 0;
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: var(--space-2) 0 0;
    text-wrap: balance;
  }

  .article-index-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
    flex: 1;
    margin: 0;
  }

  .article-index-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: var(--space-2);
  }
  .article-index-card__cta svg { transition: transform var(--duration-base) var(--easing-soft); }
  .article-index-card:hover .article-index-card__cta svg { transform: translateX(4px); }
</style>
