---
/**
 * WhereToStart — three-card section near the top of the landing page.
 * Maps user intent ("Just researching", "Ready to file", "Already mid-case")
 * to the right starting place. Pure conversion-design — direct, no fluff.
 */
import { telHref } from '../lib/firmConfig';

const cards = [
  {
    label: 'Just researching',
    title: 'Read a guide first',
    body: 'Plain-English explainers on residency, community property, custody, and support — written by an attorney, not a content mill.',
    cta: 'Browse the guides',
    href: '/guides',
  },
  {
    label: 'Ready to talk',
    title: 'Free consultation',
    body: 'A direct conversation with a California-licensed family law attorney. 30 minutes. Confidential. No pressure to retain.',
    cta: 'Schedule a call',
    href: '#consultation',
    emphasis: true,
  },
  {
    label: 'Already mid-case',
    title: 'Second-opinion review',
    body: 'For readers with existing counsel who want a candid second read on settlement terms, custody arrangements, or filing strategy.',
    cta: 'Request a review',
    href: '/second-opinion',
  },
];
---

<section class="where-to-start section">
  <div class="container">
    <header class="where-to-start__header">
      <p class="kicker">Where to start</p>
      <h2 class="where-to-start__title">
        Three ways to begin. <span class="where-to-start__title-em">Pick what fits.</span>
      </h2>
    </header>

    <div class="where-to-start__grid">
      {cards.map((card, idx) => (
        <a
          href={card.href}
          class:list={['start-card', card.emphasis && 'start-card--emphasis']}
        >
          <div class="start-card__top">
            <span class="start-card__number">{String(idx + 1).padStart(2, '0')}</span>
            <span class="start-card__label">{card.label}</span>
          </div>

          <h3 class="start-card__title">{card.title}</h3>
          <p class="start-card__body">{card.body}</p>

          <span class="start-card__cta">
            <span>{card.cta}</span>
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M4 10 H16 M11 5 L16 10 L11 15" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .where-to-start {
    background: var(--color-ground);
  }

  .where-to-start__header {
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-12);
    text-align: center;
  }

  .where-to-start__header .kicker {
    margin-bottom: var(--space-3);
  }

  .where-to-start__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.625rem);
    font-variation-settings: 'wght' 500, 'opsz' 56, 'wonk' 1;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    text-wrap: balance;
  }
  .where-to-start__title-em {
    font-style: italic;
    color: var(--color-accent);
    font-variation-settings: 'wght' 400, 'opsz' 56, 'wonk' 1;
  }

  .where-to-start__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .where-to-start__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .start-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-7);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--easing-soft),
      border-color var(--duration-base) var(--easing-soft),
      box-shadow var(--duration-base) var(--easing-soft);
  }

  .start-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-ink);
    box-shadow: 0 18px 36px -12px var(--color-shadow);
  }

  .start-card--emphasis {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }
  .start-card--emphasis::before {
    content: 'MOST PEOPLE START HERE';
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent-warm);
    background: rgba(255,255,255,0.08);
    padding: 4px 8px;
    border-radius: 999px;
  }
  .start-card--emphasis:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    box-shadow: 0 24px 48px -12px rgba(31, 58, 77, 0.4);
  }

  .start-card__top {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .start-card__number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent-warm);
  }

  .start-card__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .start-card--emphasis .start-card__label {
    color: rgba(255,255,255,0.65);
  }

  .start-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variation-settings: 'wght' 500, 'opsz' 44, 'wonk' 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: inherit;
    margin: 0;
    text-wrap: balance;
  }

  .start-card__body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: inherit;
    opacity: 0.78;
    flex: 1;
    margin: 0;
  }
  .start-card--emphasis .start-card__body { opacity: 0.85; }

  .start-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: var(--space-2);
    transition: color var(--duration-quick) var(--easing-soft);
  }
  .start-card--emphasis .start-card__cta { color: white; }
  .start-card__cta svg {
    transition: transform var(--duration-base) var(--easing-soft);
  }
  .start-card:hover .start-card__cta svg {
    transform: translateX(4px);
  }
</style>
